# ─── Environments ───────────────────────────────────────────────────────────
# Three Supabase projects, three purposes — never point one file at another
# project's data:
#   .env.local  → STAGING project (zvqkofnkjdgxlbtbwhct). What `npm run dev`
#                 loads. Safe to break, safe to seed test bookings/coaches.
#                 As the team grows, a dev can instead point this at a fully
#                 local Supabase (`supabase start`, see docs/SETUP.md) for
#                 total isolation — same variable names, different values.
#   .env.staging → reference copy of the STAGING project's values, kept in
#                 sync with what's set in Vercel → Settings → Environment
#                 Variables → Preview. Not loaded by the app directly.
#   .env.prod   → reference copy of the PRODUCTION project's values
#                 (nnzddpvhldwjvhxbrrgh), kept in sync with Vercel →
#                 Production. Not loaded by the app directly — Next.js never
#                 auto-loads a file named `.env.prod`. Real production config
#                 lives in Vercel; this file is just a local copy for
#                 reference when updating it there.
# Get any project's values from Supabase Dashboard → Project Settings → API.
# See docs/SETUP.md for the rest of the per-project dashboard checklist.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Termii — primary OTP + SMS provider for Nigeria (termii.com)
# When set, Termii is used for OTP delivery instead of Twilio
TERMII_API_KEY=
TERMII_SENDER_ID=LOBB
# Channel: "generic" (SMS), "dnd" (bypasses DND), "whatsapp" (WhatsApp Business)
TERMII_CHANNEL=generic

# Twilio — kept for WhatsApp Business notifications (non-OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM="LOBB <bookings@notifications.lobb.ng>"
EMAIL_REPLY_TO=support@lobb.ng
# Comma-separated list of admin emails — provisioned via POST /api/admin/setup
ADMIN_EMAILS=lobbnigeria@gmail.com
# Long random secret for the /api/admin/setup endpoint — generate with: openssl rand -hex 32
ADMIN_SETUP_SECRET=

# PostHog (production analytics)
NEXT_PUBLIC_POSTHOG_KEY=
# Use /ingest to route through the Next.js reverse proxy (recommended)
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Set to "true" to disable PostHog event capture (e.g. for staging/internal environments)
NEXT_PUBLIC_POSTHOG_OPT_OUT=false

# Mixpanel (product analytics)
NEXT_PUBLIC_MIXPANEL_TOKEN=a7fd42f9bdc4327b3b07ea52384a467a
NEXT_PUBLIC_MIXPANEL_ENABLED=true

# App
NEXT_PUBLIC_APP_URL=https://lobb.ng
# Public HTTPS base for email-hosted images. Use production CDN/domain, not localhost.
NEXT_PUBLIC_EMAIL_ASSET_URL=https://lobb.ng
NEXT_PUBLIC_APP_NAME=LOBB
ADMIN_SECRET=
# Supabase Auth → Hooks → Send Email — shared secret (format: v1,whsec_<base64>)
# Generate in Supabase dashboard and copy the full string including the v1,whsec_ prefix.
SUPABASE_EMAIL_HOOK_SECRET=

# Contact / social (optional — sensible defaults are used if unset)
NEXT_PUBLIC_LOBB_SUPPORT_EMAIL=support@lobb.ng
NEXT_PUBLIC_LOBB_SUPPORT_WHATSAPP=2348000000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/lobb.ng
NEXT_PUBLIC_X_URL=https://x.com/lobb_ng

# Email OTP length — must match Supabase Auth "Email OTP Length" setting (dashboard)
NEXT_PUBLIC_OTP_LENGTH=6

# ─── Auth: password + passkey ────────────────────────────────────────────────
# LOBB verifies identity once at signup (email OTP), then returning users sign
# in with a password or passkey — no more codes. Dashboard steps: docs/SETUP.md
# sections 4b–4e.
#
# Passkeys (WebAuthn). Set to "true" only after enabling the passkey/WebAuthn
# provider in Supabase → Authentication → Providers. Safe to leave off; the
# login page just hides the passkey button.
NEXT_PUBLIC_LOBB_ENABLE_PASSKEYS=false
#
# Cloudflare Turnstile — bot protection on the signup OTP request.
# Leave both blank to disable (verification fails open). Get keys at
# https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── KYC field encryption ─────────────────────────────────────────────────────
# App-level AES-256-GCM key for coaches.nin_encrypted / bvn_encrypted
# (src/lib/crypto.ts). Required for /api/coaches/kyc and /api/coaches/bank.
# Generate a NEW value per environment (staging != prod) with:
#   openssl rand -base64 32
KYC_ENCRYPTION_KEY=

# NIN verification via Dojah (dojah.io — dashboard → My Apps for AppId, →
# API Tokens → Reveal key for the secret). Get sandbox keys immediately from
# a free account; sandbox keys are prefixed test_sk_/test_pk_ and route to
# sandbox.dojah.io automatically (see src/lib/kyc.ts). Set a DIFFERENT app
# per environment — sandbox for staging, live for production.
LOBB_KYC_PROVIDER_ENABLED=false
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
